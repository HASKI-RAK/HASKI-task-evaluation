# NOTE: docker build . -t ta-frontend -f ./packages/frontend/Dockerfile.prod
# build context should be the workspaces root directory

# build environment
FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN corepack enable

# Copy workspace manifests so Yarn workspaces resolve
COPY package.json yarn.lock .yarnrc.yml ./
COPY ./packages/frontend/package.json ./packages/frontend/
COPY ./packages/lib/package.json ./packages/lib/

RUN yarn install

# Copy sources
COPY ./packages/frontend ./packages/frontend
COPY ./packages/lib ./packages/lib

# Build the frontend
WORKDIR /app/packages/frontend
RUN yarn build

# production environment
FROM nginx:stable-alpine
COPY --from=build /app/packages/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/frontend/dist /usr/share/nginx/html
RUN mkdir -p /usr/share/nginx/html/config
COPY --from=build /app/packages/frontend/public /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]